NODE_ENV=development
PORT=4001
API_PREFIX=api
API_VERSION=1
TRUST_PROXY=false

CORS_ENABLED=true
CORS_ORIGINS=http://localhost:4002
CORS_CREDENTIALS=false

SWAGGER_ENABLED=true
SWAGGER_PATH=docs
HELMET_ENABLED=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_TRACKER=ip

LOG_LEVEL=debug
LOG_FILES_ENABLED=false
REQUEST_ID_HEADER=x-request-id

HEALTH_ENABLED=true
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Use local, disposable credentials only. Never commit a real password or production URL.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
