{
  "name": "@autanasoft/database",
  "version": "0.0.0",
  "description": "Private Prisma database boundary for the AutanaSoft API.",
  "author": "AutanaSoft",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run db:generate && tsc --project tsconfig.build.json",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "test": "jest --config jest.config.cjs",
    "test:unit": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@autanasoft/jest-config": "workspace:*",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.3",
    "jest": "^30.2.0",
    "prisma": "7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
