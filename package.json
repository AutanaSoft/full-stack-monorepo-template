{
  "name": "full-stack-monorepo-template",
  "version": "0.0.1",
  "description": "AutanaSoft full-stack monorepo template for Next.js, NestJS, shadcn/ui, and shared workspace tooling.",
  "author": "AutanaSoft",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "full-stack",
    "monorepo",
    "nestjs",
    "nextjs",
    "pnpm",
    "postgresql",
    "shadcn-ui",
    "template",
    "turborepo",
    "typescript"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "db:generate": "turbo run db:generate",
    "db:validate": "turbo run db:validate",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "lint": "turbo lint && pnpm lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.{md,mdx}\"",
    "format": "turbo format && pnpm format:md",
    "format:md": "prettier --write \"**/*.{md,mdx}\"",
    "typecheck": "turbo typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm exec turbo run test:unit && pnpm exec turbo run test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@autanasoft/eslint-config": "workspace:*",
    "@autanasoft/typescript-config": "workspace:*",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "^7"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
